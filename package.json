{
  "name": "fuaran-devtools",
  "version": "0.1.1",
  "private": true,
  "description": "fuaran-devtools — a Manifest V3 browser extension that inspects any Fuaran-rendered page at the typed-tree level, over the relay@1.0 page/extension contract.",
  "license": "Apache-2.0",
  "author": "Andrew J. Willshire <andrew@fuaran.com> (Diametrical Ltd)",
  "type": "module",
  "homepage": "https://github.com/fuaran-ui/fuaran-devtools",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuaran-ui/fuaran-devtools.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
